<yandex>
  <users>
    <<%= $user %>>
<% if $password { -%>
      <password_sha256_hex><%= $password %></password_sha256_hex>
<% } -%>
<% if $quota { -%>
      <quota><%= $quota %></quota>
<% } -%>
<% if $profile { -%>
      <profile><%= $profile %></profile>
<% } -%>
<% if $allow_databases { -%>
      <allow_databases>
<% $allow_databases.each |$database| { -%>
        <database><%= $database %></database>
<% } -%>
      </allow_databases>
<% } -%>
<% if $networks { -%>
      <networks>
<% $networks.each |$k, $v| { -%>
<% $v.each |$vii| { -%>
        <<%= $k %>><%= $vii %></<%= $k %>>
<% } -%>
<% } -%>
      </networks>
<% } -%>
<% if $access_management { -%>
      <access_management><%= $access_management %></access_management>
<% } -%>
<% if $named_collection_control { -%>
      <named_collection_control><%= $named_collection_control %></named_collection_control>
<% } -%>
<% if $show_named_collections { -%>
      <show_named_collections><%= $show_named_collections %></show_named_collections>
<% } -%>
<% if $show_named_collections_secrets { -%>
      <show_named_collections_secrets><%= $show_named_collections_secrets %></show_named_collections_secrets>
<% } -%>
<% if $grants { -%>
      <grants>
<% $grants.each |$query| { -%>
        <query><%= $query %></query>
<% } -%>
      </grants>
<% } -%>
    </<%= $user %>>
  </users>
</yandex>
